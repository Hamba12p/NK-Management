# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used only by `npm run seed:users`; never expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Initial password for the seven staff/shared accounts. Store and distribute securely.
NK_SHARED_INITIAL_PASSWORD=
# Dedicated recovery administrator. Its password must be distinct and kept in a password manager.
NK_MASTER_ADMIN_EMAIL=
NK_MASTER_ADMIN_PASSWORD=
# Board-only M&E login. The master admin email is accepted as an alias for this account.
NK_ME_BOARD_EMAIL=
NK_ME_BOARD_PASSWORD=
