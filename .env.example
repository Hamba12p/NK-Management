# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
INTERN_TEAM_DIRECTORY_ENABLED=false
# Exact email of the verified volunteer lead who may access StaffHub beyond OBX.
STAFFHUB_VOLUNTEER_REP_EMAIL=
# Server-only: required by authenticated document preview/download routes.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only OBX requirements. Generate separate random values of at least 32 characters.
OBX_SESSION_SECRET=
OBX_IP_SALT=

# Public key is safe to expose. Generate VAPID keys with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only Web Push credentials. Never expose or commit these values.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@the-nkfoundation.org
PUSH_DISPATCH_SECRET=
# Protects the Vercel scheduled quiet-hours delivery job.
CRON_SECRET=
